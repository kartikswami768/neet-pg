filters:
  and:
    - file.inFolder("Study Material/Flashcards/Marrow Pearls")
    - '!file.inFolder("Study Material/Flashcards/Marrow Pearls/images")'
formulas:
  Untitled: ""
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Study Material/Flashcards/Marrow Pearls")
        - topic.contains("Cardiovascular System")
    order:
      - file.name
      - tags
      - topic
      - pearl_id
    sort:
      - property: file.name
        direction: ASC
      - property: file.ctime
        direction: DESC
      - property: pearl_id
        direction: ASC
    columnSize:
      note.tags: 500
  - type: cards
    name: Cards
    filters:
      or:
        - file.path.startsWith("Study Material/Flashcards/Marrow Pearls")
        - and:
            - file.inFolder("Study Material/Flashcards/Marrow Pearls")
            - and:
                - file.hasTag("marrow-pearl", "flashcards")
    order:
      - title
      - pearl_id
    cardSize: 260
    imageAspectRatio: 1.55
  - type: table
    name: All view
