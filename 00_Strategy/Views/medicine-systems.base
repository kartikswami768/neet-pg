filters:
  and:
    - type == "curriculum"
    - subject == "Medicine"
views:
  - type: table
    name: Medicine Systems
    order:
      - section
      - topic
      - coverage
      - confidence
      - revision_count
      - next_revision
      - primary_note
    sort:
      - property: section
        direction: ASC
      - property: topic
        direction: ASC
