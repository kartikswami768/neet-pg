filters:
  and:
    - type == "curriculum"
    - list(covered_in).map(file(value)).contains(this.file.asLink())
views:
  - type: table
    name: Coverage From This Cycle
    order:
      - file.name
      - subject
      - section
      - topic
      - coverage
      - confidence
      - primary_note
    sort:
      - property: subject
        direction: ASC
      - property: section
        direction: ASC
      - property: topic
        direction: ASC
