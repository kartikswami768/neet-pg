filters:
  and:
    - file.hasTag("task")
    - file.inFolder("00_Strategy/Tasks")
    - status != "done"
views:
  - type: table
    name: Today / Open Tasks
    filters:
      and:
        - scheduled
        - date(scheduled).format("YYYY-MM-DD") <= today().format("YYYY-MM-DD")
    order:
      - file.name
      - status
      - priority
      - scheduled
      - due
      - projects
      - file.folder
    sort:
      - property: scheduled
        direction: ASC
      - property: priority
        direction: DESC
  - type: table
    name: Upcoming
    filters:
      and:
        - scheduled
        - date(scheduled).format("YYYY-MM-DD") > today().format("YYYY-MM-DD")
        - date(scheduled).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD")
    order:
      - file.name
      - status
      - priority
      - scheduled
      - due
      - projects
    sort:
      - property: scheduled
        direction: ASC
