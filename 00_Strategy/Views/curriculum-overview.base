filters:
  and:
    - type == "curriculum"
views:
  - type: table
    name: Curriculum
    order:
      - file.name
      - subject
      - section
      - topic
      - coverage
      - revision_count
      - confidence
      - last_studied
      - next_revision
      - note_status
      - primary_note
    sort:
      - property: subject
        direction: ASC
      - property: section
        direction: ASC
      - property: topic
        direction: ASC
